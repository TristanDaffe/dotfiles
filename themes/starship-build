#!/usr/bin/env bash
# starship-build — compose ~/.config/starship.toml from the current bar + palette.
#
# Every other app reads its theme through a symlink. Starship cannot: it is one
# process reading one file, with no include mechanism. So the two halves are
# concatenated here instead.
#
#   themes/current-bar/starship.toml   SHAPE   — format string + module blocks,
#                                               written against palette NAMES
#   themes/current/starship.toml       COLOUR  — a single [palettes.theme] block
#
# Both halves use the same palette table name, `theme`, so one bar file works
# with every palette. TOML also requires top-level keys before any table, which
# is why the bar half (format, palette) is written first and the palette half
# contains nothing but a table.
#
# Run by theme-set and bar-set. Safe to run by hand.
set -uo pipefail

THEMES_DIR="${THEMES_DIR:-$HOME/.config/themes}"
BAR="$THEMES_DIR/current-bar/starship.toml"
PAL="$THEMES_DIR/current/starship.toml"
OUT="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"

if [ ! -r "$BAR" ] || [ ! -r "$PAL" ]; then
    echo "starship-build: no starship.toml for this bar or palette" >&2
    exit 1
fi

bar_name="$(basename "$(readlink "$THEMES_DIR/current-bar" 2>/dev/null || echo '?')")"
pal_name="$(basename "$(readlink "$THEMES_DIR/current" 2>/dev/null || echo '?')")"

# Written to a temp file and moved into place. starship re-reads its config on
# every prompt, so a half-written file would be read by the very next one.
tmp="$OUT.$$.tmp"
{
    printf '# GENERATED by themes/starship-build — do not edit.\n'
    printf '#\n'
    printf '# bar     %s   (bar-set)\n' "$bar_name"
    printf '# palette %s   (theme-set)\n' "$pal_name"
    printf '#\n'
    printf '# Edit themes/bars/%s/starship.toml for the shape,\n' "$bar_name"
    printf '# or themes/palettes/%s/starship.toml for the colours.\n\n' "$pal_name"
    cat "$BAR"
    printf '\n'
    cat "$PAL"
} > "$tmp" || { rm -f "$tmp"; exit 1; }
mv -f "$tmp" "$OUT"
